+/*
+ * (0342) The MAX77854's MFD/charger page at 0x66 shares this bus with the gauge (Samsung: slave 0xcc, CHG_INT_OK
+ * 0xb2, CHG_DTLS_00/01 0xb3/0xb4, CNFG 0xb7-0xc6). One lock for every transfer on the bus.
+ */
+static LCK_GRP_DECLARE(fg_grp, "herolte_fg");
+static LCK_MTX_DECLARE(fg_mtx, &fg_grp);
+static uint32_t fg_target = 0x36u;
+volatile unsigned herolte_fg_cycles;
 
 #define FG_HSI2C_PA     0x13650000u
 #define FG_PINS_PA      0x136d0000u     /* GPI0 +0x00, GPD0 +0x20, GPD1 +0x40 */
@@ -97,7 +113,7 @@ fg_message(bool receive, uint8_t *bytes, unsigned count, bool stop)
 
 	fg_wr(fg_i2c, HSI2C_INT_STAT, fg_rd(fg_i2c, HSI2C_INT_STAT));
 	fg_wr(fg_i2c, HSI2C_FIFO_CTL, 3u | (receive ? (1u << 4) : (1u << 16)));
-	fg_wr(fg_i2c, HSI2C_ADDR, FG_ADDR << 10);
+	fg_wr(fg_i2c, HSI2C_ADDR, fg_target << 10);
 	fg_wr(fg_i2c, HSI2C_CTL, 9u | (receive ? 0x40u : 0x80u));
 	fg_wr(fg_i2c, HSI2C_INT_EN, 0xf80u | (receive ? 0x42u : 1u));
 	/* Bit 16 read, bit 17 STOP_AFTER_TRANS, bit 31 MASTER_RUN. */
@@ -199,11 +215,51 @@ int
 herolte_fg_read(unsigned *percent, unsigned *mv, int *ma, unsigned *rem_mah, unsigned *full_mah)
 {
 	uint16_t soc, vcell, current, rem, full;
-	if (!fg_i2c || !fg_word(FG_REPSOC, &soc) || !fg_word(FG_VCELL, &vcell) ||
-	    !fg_word(FG_CURRENT, &current) || !fg_word(FG_REPCAP, &rem) ||
-	    !fg_word(FG_FULLCAP, &full)) {
+	if (!fg_i2c) {
+		return -1;
+	}
+	lck_mtx_lock(&fg_mtx);
+	fg_target = FG_ADDR;
+	bool ok = fg_word(FG_REPSOC, &soc) && fg_word(FG_VCELL, &vcell) &&
+	    fg_word(FG_CURRENT, &current) && fg_word(FG_REPCAP, &rem) &&
+	    fg_word(FG_FULLCAP, &full);
+	uint16_t temp = 0;
+	bool temp_ok = ok && fg_word(0x08, &temp);
+	/*
+	 * (0345) MAX17047-family registers: VFSOC 0xff (voltage model), MIXSOC 0x0d, AVSOC 0x0e, REPSOC 0x06 (reported),
+	 * VFOCV 0xfb (open-circuit estimate, VCELL scale), FULLCAPNOM 0x23, CYCLES 0x17 (1% of a cycle), DESIGNCAP 0x18.
+	 */
+	static unsigned socs_logged;
+	uint16_t cyc = 0;
+	if (ok && fg_word(0x17, &cyc)) {
+		herolte_fg_cycles = cyc / 100u;
+	}
+	if (ok && socs_logged++ % 30 == 0) {
+		uint16_t vf = 0, mix = 0, av = 0, ocv = 0, nom = 0, dcap = 0, mixcap = 0, avcap = 0;
+		fg_word(0xff, &vf);
+		fg_word(0x0d, &mix);
+		fg_word(0x0e, &av);
+		fg_word(0xfb, &ocv);
+		fg_word(0x23, &nom);
+		fg_word(0x18, &dcap);
+		fg_word(0x0f, &mixcap);
+		fg_word(0x1f, &avcap);
+		printf("HEROLTE FG: rep %u.%02u%% vf %u.%02u%% mix %u.%02u%% av %u.%02u%%, ocv %u mV vcell %u mV, "
+		    "cap rep %u mix %u av %u full %u nom %u design %u mAh, cycles %u.%02u\n",
+		    soc >> 8, (soc & 0xff) * 100 / 256, vf >> 8, (vf & 0xff) * 100 / 256, mix >> 8, (mix & 0xff) * 100 / 256,
+		    av >> 8, (av & 0xff) * 100 / 256, (unsigned)((uint64_t)ocv * 78125u / 1000000u),
+		    (unsigned)((uint64_t)vcell * 78125u / 1000000u), rem / 2u, mixcap / 2u, avcap / 2u, full / 2u, nom / 2u,
+		    dcap / 2u, cyc / 100u, cyc % 100u);
+	}
+	lck_mtx_unlock(&fg_mtx);
+	if (!ok) {
 		return -1;
 	}
+	/* (0330) TEMP 0x08: signed, 1/256 degree (the MAX17047 family's; Linux in TWRP read 30.6 C from it) */
+	extern volatile int herolte_fg_temp_dc;         /* bsd/dev/herolte_gpu.c, for the heat limit */
+	if (temp_ok) {
+		herolte_fg_temp_dc = (int)(int16_t)temp * 10 / 256;
+	}
 	unsigned permille = ((unsigned)soc * 10u) >> 8;
 	unsigned p = (permille * 1000u / FG_CAPACITY_MAX + 5u) / 10u;
 	*percent = p > 100 ? 100 : p;
@@ -213,4 +269,366 @@ herolte_fg_read(unsigned *percent, unsigned *mv, int *ma, unsigned *rem_mah, uns
 	*full_mah = full / 2u;
 	return 0;
 }
+
+static bool
+hm_read(uint32_t page, uint8_t reg, uint8_t *value)
+{
+	if (!fg_i2c) {
+		return false;
+	}
+	lck_mtx_lock(&fg_mtx);
+	fg_target = page;
+	bool ok = false;
+	for (unsigned attempt = 0; attempt < 3 && !ok; attempt++) {
+		ok = fg_message(false, &reg, 1, false) && fg_message(true, value, 1, true);
+	}
+	fg_target = FG_ADDR;
+	lck_mtx_unlock(&fg_mtx);
+	return ok;
+}
+
+static bool
+hm_write(uint32_t page, uint8_t reg, uint8_t value)
+{
+	if (!fg_i2c) {
+		return false;
+	}
+	uint8_t b[2] = { reg, value };
+	lck_mtx_lock(&fg_mtx);
+	fg_target = page;
+	bool ok = false;
+	for (unsigned attempt = 0; attempt < 3 && !ok; attempt++) {
+		ok = fg_message(false, b, 2, true);
+	}
+	fg_target = FG_ADDR;
+	lck_mtx_unlock(&fg_mtx);
+	return ok;
+}
+
+bool
+herolte_pmic66_read(uint8_t reg, uint8_t *value)
+{
+	return hm_read(0x66u, reg, value);
+}
+
+bool
+herolte_pmic66_write(uint8_t reg, uint8_t value)
+{
+	return hm_write(0x66u, reg, value);
+}
+
+/* (0344) Samsung's max77854-private.h: PMIC/haptic 0xCC (0x66 here), charger 0xD2, gauge 0x6C, MUIC 0x4A. */
+#define HM_CHG  0x69u
+#define HM_MUIC 0x25u
+
+static unsigned
+hm_chgin_ma(uint8_t v)
+{
+	v &= 0x7fu;
+	return v <= 3 ? 100u : v >= 0x78 ? 4000u : (v / 3u) * 100u + (v % 3u == 1 ? 33u : v % 3u == 2 ? 67u : 0u);
+}
+
+/*
+ * (0345) MUIC STATUS2 0x05: CHGTYP [2:0] (0 none, 1 USB, 2 CDP, 3 dedicated charger, 4 500 mA, 5 1 A, 6 3.3 V special),
+ * VBVOLT bit 6. Boot-arg herochgin=N (mA, default 1500, 0: leave the limit): with a dedicated charger or a CDP the
+ * CHGIN limit (CNFG_09, after the CNFG_06 CHGPROT unlock as Samsung's init) goes up to N; a 1 A charger to 1000. A PC
+ * port (USB, 500 mA) is left as the bootloader set it.
+ */
+static uint32_t hm_chgin_target = 1500;
+static bool hm_chgin_parsed, hm_raised;
+
+/*
+ * Cable and charge state from the charger itself, not the gauge's current: CHGIN_OK (0xb2 bit 6) with CHGIN_DTLS
+ * (0xb3 [6:5]) 3 = valid VBUS; CHG_DTLS (0xb4 [3:0]) 0-2 charging, 3-4 top-off/done (Samsung counts both as full).
+ * The bootloader's configuration (CNFG_00 mode, CNFG_02 charge current in 50 mA, CNFG_09 input limit in 30 mA)
+ * is logged once and left as it is.
+ */
+int
+herolte_chg_state(bool *external, bool *charging, bool *full)
+{
+	uint8_t ok = 0, d0 = 0, d1 = 0;
+	if (!hm_read(HM_CHG, 0xb2, &ok) || !hm_read(HM_CHG, 0xb3, &d0) || !hm_read(HM_CHG, 0xb4, &d1)) {
+		return -1;
+	}
+	static uint8_t last_ok = 0xff, last_d1 = 0xff;
+	static unsigned logged;
+	if ((ok != last_ok || (d1 & 0x0f) != last_d1) && logged < 40) {
+		logged++;
+		uint8_t c0 = 0, c2 = 0, c9 = 0, c10 = 0, d2 = 0, id = 0, m1 = 0, m2 = 0, m3 = 0, c6 = 0;
+		hm_read(HM_MUIC, 0x04, &m1);
+		hm_read(HM_MUIC, 0x05, &m2);
+		hm_read(HM_MUIC, 0x06, &m3);
+		hm_read(HM_CHG, 0xbd, &c6);
+		hm_read(HM_CHG, 0xb5, &d2);
+		hm_read(HM_CHG, 0xb7, &c0);
+		hm_read(HM_CHG, 0xb9, &c2);
+		hm_read(HM_CHG, 0xc0, &c9);
+		hm_read(HM_CHG, 0xc1, &c10);
+		herolte_pmic66_read(0x00, &id);
+		printf("HEROLTE CHG: muic %#x/%#x/%#x (type %u), cnfg_06 %#x, pmic id %#x, int_ok %#x dtls %#x/%#x/%#x cnfg_00 %#x, charge %u mA (cnfg_02 %#x), input %u mA (cnfg_09 %#x, cnfg_10 %#x)\n",
+		    m1, m2, m3, m2 & 7u, c6, id, ok, d0, d1, d2, c0, (c2 & 0x3fu) * 50u, c2, hm_chgin_ma(c9), c9, c10);
+		last_ok = ok;
+		last_d1 = d1 & 0x0f;
+	}
+	unsigned dtls = d1 & 0x0fu;
+	*external = (ok & 0x40u) != 0 && ((d0 >> 5) & 3u) == 3u;
+	if (!hm_chgin_parsed) {
+		hm_chgin_parsed = true;
+		PE_parse_boot_argn("herochgin", &hm_chgin_target, sizeof(hm_chgin_target));
+		if (hm_chgin_target > 2000) {
+			hm_chgin_target = 2000;
+		}
+	}
+	if (!*external) {
+		hm_raised = false;
+	} else if (!hm_raised && hm_chgin_target) {
+		uint8_t m2 = 0, c6 = 0, c9 = 0;
+		if (hm_read(HM_MUIC, 0x05, &m2) && hm_read(HM_CHG, 0xc0, &c9)) {
+			unsigned type = m2 & 7u, want = type == 2 || type == 3 ? hm_chgin_target : type == 5 ? 1000u : 0u;
+			if (want > 1000u && want > hm_chgin_ma(c9) && hm_read(HM_CHG, 0xbd, &c6)) {
+				uint8_t code = (uint8_t)((want / 100u) * 3u + (want % 100u >= 67u ? 2u : want % 100u >= 33u ? 1u : 0u));
+				bool w = ((c6 & 0x0cu) == 0x0cu || hm_write(HM_CHG, 0xbd, (uint8_t)(c6 | 0x0cu))) &&
+				    hm_write(HM_CHG, 0xc0, (uint8_t)((c9 & 0x80u) | code));
+				uint8_t back = 0;
+				hm_read(HM_CHG, 0xc0, &back);
+				printf("HEROLTE CHG: type %u, input limit %u -> %u mA (cnfg_09 %#x): %s\n", type, hm_chgin_ma(c9),
+				    hm_chgin_ma(back), back, w ? "ok" : "failed");
+			} else if (want == 1000u && hm_chgin_ma(c9) < 1000u) {
+				printf("HEROLTE CHG: type %u (1 A charger), input left at %u mA\n", type, hm_chgin_ma(c9));
+			}
+			hm_raised = true;
+		}
+	}
+	*charging = *external && dtls <= 2;
+	*full = *external && (dtls == 3 || dtls == 4);
+	return 0;
+}
+
+/*
+ * (0343) The vibration motor, as Samsung's max77854_haptic.c with this phone's DTB (exynos8890-herolte_motor.dtsi):
+ * an LRA on the MAX77854's haptic driver, MCONFIG 0x10 = 0x82 (LRA, divider 128) and MOTOR_EN (bit 6) to run,
+ * BIASEN (MAINCTRL1 0x02 bit 7) once; its supply VDD_MOT_3.3V is the S2MPS16's LDO34 (L34CTRL 0x5e, enable [7:6]);
+ * the drive is PWM timer 1 of 0x136c0000 on GPD0-5 (function 2, pull-down), period 37950 ns, duty 32500 ns (the
+ * strongest; half the period is no force). herolte_vibrate(ms) runs it for ms (0: stop).
+ */
+#define HV_PWM_PA       0x136c0000u
+#define HV_GPD0         0x20
+#define HV_PERIOD_NS    37950u
+#define HV_DUTY_NS      32500u
+extern bool herolte_apm_pmic_read(uint8_t reg, uint8_t *value);
+extern bool herolte_apm_pmic_write(uint8_t reg, uint8_t value);
+void herolte_vibrate(uint32_t ms);
+static vm_offset_t hv_pwm;
+static uint64_t hv_tin_hz;
+static int hv_state;            /* 0 not set up, 1 ready, -1 failed */
+static LCK_MTX_DECLARE(hv_mtx, &fg_grp);
+
+static void
+hv_pwm_set(uint32_t duty_ns)
+{
+	uint32_t tcnt = (uint32_t)(hv_tin_hz * HV_PERIOD_NS / 1000000000ull);
+	uint32_t high = (uint32_t)(hv_tin_hz * duty_ns / 1000000000ull);
+	if (tcnt < 4) {
+		return;
+	}
+	if (high >= tcnt) {
+		high = tcnt - 1;
+	}
+	/* pwm-samsung.c: TCNTB = tcnt - 1, TCMPB = tcnt - 1 - high (the output is high while TCNT > TCMP) */
+	fg_wr(hv_pwm, 0x18, tcnt - 1);
+	fg_wr(hv_pwm, 0x1c, tcnt - 1 - high);
+}
+
+static bool
+hv_setup(void)
+{
+	uint8_t l34 = 0, v = 0;
+	if (!herolte_apm_pmic_read(0x5e, &l34)) {
+		return false;       /* the APM is not up yet */
+	}
+	hv_pwm = ml_io_map(HV_PWM_PA, 0x1000);
+	if (!hv_pwm || !fg_pins) {
+		hv_state = -1;
+		return false;
+	}
+	printf("HEROLTE VIB: LDO34 %#x, GPD0 con %#x pud %#x, PWM tcfg0 %#x tcfg1 %#x tcon %#x tcntb1 %#x tcmpb1 %#x\n", l34,
+	    fg_rd(fg_pins, HV_GPD0), fg_rd(fg_pins, HV_GPD0 + 8), fg_rd(hv_pwm, 0x00), fg_rd(hv_pwm, 0x04), fg_rd(hv_pwm, 0x08),
+	    fg_rd(hv_pwm, 0x18), fg_rd(hv_pwm, 0x1c));
+	/* GPD0-5: TOUT1 (function 2), pull-down */
+	fg_wr(fg_pins, HV_GPD0, (fg_rd(fg_pins, HV_GPD0) & ~(0xfu << 20)) | (2u << 20));
+	fg_wr(fg_pins, HV_GPD0 + 8, (fg_rd(fg_pins, HV_GPD0 + 8) & ~(3u << 10)) | (1u << 10));
+	/* timer 1: prescaler 0 (+1), divider 1/1; its input clock measured with a free count */
+	uint32_t tcon = fg_rd(hv_pwm, 0x08) & ~(0xbu << 8);
+	fg_wr(hv_pwm, 0x04, fg_rd(hv_pwm, 0x04) & ~(0xfu << 4));
+	uint32_t pre = fg_rd(hv_pwm, 0x00) & 0xffu;
+	fg_wr(hv_pwm, 0x00, fg_rd(hv_pwm, 0x00) & ~0xffu);
+	fg_wr(hv_pwm, 0x18, 0xffffffffu);
+	fg_wr(hv_pwm, 0x1c, 0);
+	fg_wr(hv_pwm, 0x08, tcon | (1u << 9));
+	fg_wr(hv_pwm, 0x08, tcon | (1u << 8));
+	uint64_t t0 = mach_absolute_time();
+	uint32_t c0 = fg_rd(hv_pwm, 0x20);
+	delay(2000);
+	uint32_t c1 = fg_rd(hv_pwm, 0x20);
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	fg_wr(hv_pwm, 0x08, tcon);
+	hv_tin_hz = ns ? (uint64_t)(c0 - c1) * 1000000000ull / ns : 0;
+	printf("HEROLTE VIB: timer 1 counts %u in %llu ns (prescaler was %u, now 0): %llu Hz\n", c0 - c1, ns, pre, hv_tin_hz);
+	if (hv_tin_hz < 1000000) {
+		printf("HEROLTE VIB: the PWM timer does not run, no vibration\n");
+		hv_state = -1;
+		return false;
+	}
+	/* idle drive: half the period (no force), auto-reload */
+	hv_pwm_set(HV_PERIOD_NS / 2);
+	fg_wr(hv_pwm, 0x08, tcon | (1u << 9) | (1u << 11));
+	fg_wr(hv_pwm, 0x08, tcon | (1u << 11));
+	/* the supply, then the haptic block (Samsung: 6 ms after the supply) */
+	if (!(l34 & 0xc0u) && !herolte_apm_pmic_write(0x5e, (uint8_t)(l34 | 0xc0u))) {
+		printf("HEROLTE VIB: LDO34 enable failed\n");
+		hv_state = -1;
+		return false;
+	}
+	delay(6000);
+	uint8_t main1 = 0, mcfg = 0;
+	bool ok = herolte_pmic66_read(0x02, &main1) && herolte_pmic66_write(0x02, (uint8_t)(main1 | 0x80u)) &&
+	    herolte_pmic66_read(0x10, &mcfg) && herolte_pmic66_write(0x10, 0x82u);
+	herolte_apm_pmic_read(0x5e, &v);
+	printf("HEROLTE VIB: LDO34 now %#x, MAINCTRL1 %#x -> %#x, MCONFIG %#x -> 0x82: %s\n", v, main1, main1 | 0x80u, mcfg,
+	    ok ? "ready" : "failed");
+	hv_state = ok ? 1 : -1;
+	return ok;
+}
+
+static uint32_t hv_on_ms, hv_off_ms, hv_duty = HV_DUTY_NS, hv_gen;
+static bool hv_repeat;
+static uint64_t hv_until;       /* a repeating pattern stops by itself after 2 minutes */
+static thread_call_t hv_call;
+void herolte_vib_pattern(uint32_t on_ms, uint32_t off_ms, bool repeat, uint32_t intensity_q16);
+
+static void
+hv_motor_locked(bool on)
+{
+	uint32_t tcon = fg_rd(hv_pwm, 0x08) & ~(0xbu << 8);
+	if (on) {
+		hv_pwm_set(hv_duty);
+		fg_wr(hv_pwm, 0x08, tcon | (1u << 9) | (1u << 11));
+		fg_wr(hv_pwm, 0x08, tcon | (1u << 8) | (1u << 11));
+		herolte_pmic66_write(0x10, 0x82u | 0x40u);
+	} else {
+		herolte_pmic66_write(0x10, 0x82u);
+		hv_pwm_set(HV_PERIOD_NS / 2);
+		fg_wr(hv_pwm, 0x08, tcon);
+	}
+}
+
+static void
+hv_schedule_locked(uint32_t ms, bool turn_on)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	thread_call_enter1_delayed(hv_call, (thread_call_param_t)(uintptr_t)((hv_gen << 1) | (turn_on ? 1u : 0u)), deadline);
+}
+
+static void
+hv_tick(__unused thread_call_param_t p0, thread_call_param_t p1)
+{
+	uint32_t v = (uint32_t)(uintptr_t)p1;
+	lck_mtx_lock(&hv_mtx);
+	if (hv_state != 1 || (v >> 1) != hv_gen) {
+		lck_mtx_unlock(&hv_mtx);
+		return;
+	}
+	bool more = hv_repeat && mach_absolute_time() < hv_until;
+	if (v & 1u) {
+		if (more) {
+			hv_motor_locked(true);
+			hv_schedule_locked(hv_on_ms, false);
+		}
+	} else if (more && hv_off_ms == 0) {
+		hv_schedule_locked(hv_on_ms, false);    /* continuous */
+	} else {
+		hv_motor_locked(false);
+		if (more) {
+			hv_schedule_locked(hv_off_ms, true);
+		}
+	}
+	lck_mtx_unlock(&hv_mtx);
+}
+
+/* on_ms 0: stop. intensity_q16: 16.16 fixed (iOS's "intensity"), 0 or >= 1.0: full force. */
+void
+herolte_vib_pattern(uint32_t on_ms, uint32_t off_ms, bool repeat, uint32_t intensity_q16)
+{
+	lck_mtx_lock(&hv_mtx);
+	if (hv_state == 0) {
+		hv_setup();
+	}
+	if (hv_state != 1) {
+		lck_mtx_unlock(&hv_mtx);
+		return;
+	}
+	if (!hv_call) {
+		hv_call = thread_call_allocate_with_options(hv_tick, NULL, THREAD_CALL_PRIORITY_HIGH, 0);
+	}
+	hv_gen++;
+	if (hv_call) {
+		thread_call_cancel(hv_call);
+	}
+	if (on_ms == 0 || !hv_call) {
+		hv_repeat = false;
+		hv_motor_locked(false);
+		lck_mtx_unlock(&hv_mtx);
+		return;
+	}
+	hv_on_ms = on_ms > 10000 ? 10000 : on_ms;       /* haptic,max_timeout */
+	hv_off_ms = off_ms > 10000 ? 10000 : off_ms;
+	hv_repeat = repeat;
