+/*
+ * (0341) Boot-arg herogpu_sleep=N: a client's job is polled for herogpu_spin us (50 by default), then the thread
+ * sleeps N us at a time between polls instead of spinning (delay(10) spins here, a core busy for every job of the
+ * ~15 a frame). 0 (default): polled as before.
+ */
+static uint32_t hg_sleep_us, hg_spin_us = 50;
+static uint64_t hg_sleeps, hg_sleep_jobs;
 /* GPU VA of the job chain hg_run() starts, and of its header (for the log). */
