@@ -763,6 +770,33 @@ hg_run(unsigned js, const char *what)
 	hg_wr(hg_gpu, slot + 0x60, 1);                          /* START */
 
 	uint32_t jirq = 0, mirq = 0, girq = 0;
+	if (hg_run_quiet && hg_sleep_us != 0) {
+		uint64_t t0 = mach_absolute_time(), spin, step, limit;
+		nanoseconds_to_absolutetime((uint64_t)hg_spin_us * 1000, &spin);
+		nanoseconds_to_absolutetime((uint64_t)hg_sleep_us * 1000, &step);
+		nanoseconds_to_absolutetime(200000000ULL, &limit);
+		bool slept = false;
+		for (;;) {
+			jirq = hg_rd(hg_gpu, JOB_IRQ_RAWSTAT);
+			mirq = hg_rd(hg_gpu, MMU_IRQ_RAWSTAT);
+			girq = hg_rd(hg_gpu, GPU_IRQ_RAWSTAT);
+			if ((jirq & ((1u << js) | (1u << (js + 16)))) || mirq || (girq & 0x81)) {
+				break;
+			}
+			uint64_t now = mach_absolute_time();
+			if (now - t0 > limit) {
+				break;
+			}
+			if (now - t0 < spin) {
+				continue;
+			}
+			assert_wait_deadline((event_t)&hg_sleeps, THREAD_UNINT, now + step);
+			thread_block(THREAD_CONTINUE_NULL);
+			hg_sleeps++;
+			slept = true;
+		}
+		hg_sleep_jobs += slept ? 1 : 0;
+	} else {
 	for (unsigned i = 0; i < 20000; i++) {
