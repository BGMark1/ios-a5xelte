 {
 	const uint32_t fifo = hg_rd(dsim, HERO_DSIM_FIFOCTRL);
 	const uint32_t status = hg_rd(dsim, HERO_DSIM_STATUS);
 	const uint32_t config = hg_rd(dsim, HERO_DSIM_CMD_CONFIG);
 	if (!(status & HERO_DSIM_HS_READY) || (config & HERO_DSIM_PACKETGO) ||
 	    (fifo & (HERO_DSIM_PH_EMPTY | HERO_DSIM_RX_EMPTY)) != (HERO_DSIM_PH_EMPTY | HERO_DSIM_RX_EMPTY)) {
-		printf("HEROLTE PANEL: ID skipped, DSIM status %#x fifo %#x cmd config %#x\n", status, fifo, config);
-		return;
+		printf("HEROLTE PANEL: read %#x skipped, DSIM status %#x fifo %#x cmd config %#x\n", reg, status, fifo, config);
+		return false;
 	}
 
 	hg_wr(dsim, HERO_DSIM_INTSRC, HERO_DSIM_RX_DONE);
