+	hg_wr(dsim, HERO_DSIM_PKTHDR, 0x37u | (count << 8)); /* Maximum return packet size */
 	if (!hero_dsim_wait(dsim, HERO_DSIM_FIFOCTRL, HERO_DSIM_PH_EMPTY)) {
 		printf("HEROLTE PANEL: DSIM did not send maximum return packet size\n");
-		return;
-	}
-	hg_wr(dsim, HERO_DSIM_PKTHDR, 0x06u | (0x04u << 8)); /* DCS read, bus turnaround by packet type */
+		return false;
+	}
+	hg_wr(dsim, HERO_DSIM_PKTHDR, 0x06u | ((uint32_t)reg << 8)); /* DCS read, automatic turnaround */
 	const bool done = hero_dsim_wait(dsim, HERO_DSIM_INTSRC, HERO_DSIM_RX_DONE);
-	uint32_t id = 0, first = 0;
-	bool found = false, bad = false;
+	uint32_t first = 0;
+	unsigned received = 0;
+	bool bad = false;
 	for (unsigned i = 0; i < 64 && !(hg_rd(dsim, HERO_DSIM_FIFOCTRL) & HERO_DSIM_RX_EMPTY); i++) {
 		const uint32_t hdr = hg_rd(dsim, HERO_DSIM_RXFIFO);
+		const uint32_t type = hdr & 0x3f;
 		if (i == 0) {
 			first = hdr;
 		}
-		if ((hdr & 0x3f) == 0x1c || (hdr & 0x3f) == 0x1a) { /* DCS or generic long response */
-			const uint32_t size = (hdr >> 8) & 0xffff;
-			if (size != 3 || found || (hg_rd(dsim, HERO_DSIM_FIFOCTRL) & HERO_DSIM_RX_EMPTY)) {
+		if (type == 0x1c || type == 0x1a) { /* DCS or generic long response */
+			if (((hdr >> 8) & 0xffff) != count || received != 0) {
 				bad = true;
 				break;
 			}
-			id = hg_rd(dsim, HERO_DSIM_RXFIFO);
-			i++;
-			found = true;
-		} else if ((hdr & 0x3f) != 0x08 && ((hdr & 0x3f) != 0x02 || ((hdr >> 8) & 0xffff) != 0)) {
+			for (unsigned j = 0; j < count && i + 1 < 64; j += 4) {
+				if (hg_rd(dsim, HERO_DSIM_FIFOCTRL) & HERO_DSIM_RX_EMPTY) {
+					break;
+				}
+				const uint32_t word = hg_rd(dsim, HERO_DSIM_RXFIFO);
+				i++;
+				for (unsigned k = 0; k < 4 && j + k < count; k++) {
