+
+/* Exynos8890 sends a 2-byte DCS command as short-with-parameter (0x15). */
+static bool
+hero_dsim_write(vm_offset_t dsim, const uint8_t *data, unsigned count)
+{
+	if (!(hg_rd(dsim, HERO_DSIM_STATUS) & HERO_DSIM_HS_READY) ||
+	    (hg_rd(dsim, HERO_DSIM_CMD_CONFIG) & HERO_DSIM_PACKETGO) ||
+	    !hero_dsim_wait(dsim, HERO_DSIM_FIFOCTRL, HERO_DSIM_PH_EMPTY)) {
+		return false;
+	}
+	if (count == 2) {
+		hg_wr(dsim, HERO_DSIM_PKTHDR, 0x15u | (uint32_t)data[0] << 8 | (uint32_t)data[1] << 16);
 	} else {
-		printf("HEROLTE PANEL: no valid DCS ID (done %u first %#x fifo %#x)\n", (unsigned)done, first, after);
+		for (unsigned i = 0; i < count; i += 4) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < 4 && i + j < count; j++) {
+				word |= (uint32_t)data[i + j] << (8 * j);
+			}
+			hg_wr(dsim, HERO_DSIM_PAYLOAD, word);
+		}
+		hg_wr(dsim, HERO_DSIM_PKTHDR, 0x39u | count << 8);
+	}
+	return hero_dsim_wait(dsim, HERO_DSIM_FIFOCTRL, HERO_DSIM_PH_EMPTY);
+}
+
+static bool
+hero_dsim_apply_aor(vm_offset_t dsim, const uint8_t aor[11])
+{
+	const uint8_t update[] = { 0xf7, 0x03 }, update_end[] = { 0xf7, 0x00 };
+	return hero_dsim_write(dsim, aor, 11) && hero_dsim_write(dsim, update, sizeof(update)) &&
+	       hero_dsim_write(dsim, update_end, sizeof(update_end));
+}
+
+/* One reversible test on the TWRP-identified HA3 daisy. Gamma and voltages stay as inherited. */
+static void
+hero_dsim_aor_trial(vm_offset_t dsim)
+{
+	const uint8_t open_f0[] = { 0xf0, 0x5a, 0x5a }, open_fc[] = { 0xfc, 0x5a, 0x5a };
+	const uint8_t close_fc[] = { 0xfc, 0xa5, 0xa5 }, close_f0[] = { 0xf0, 0xa5, 0xa5 };
+	/* Stock HA3 B1 prefix, followed by the stock daisy AOR for index 128. */
+	const uint8_t test[] = { 0xb1, 0x54, 0x20, 0x1a, 0x33, 0x5e, 0x8c, 0xb3, 0xd9, 0x30, 0x61 };
+	uint8_t original[sizeof(test)] = { 0xb1 };
+	if (hero_dsim_write(dsim, open_f0, sizeof(open_f0)) &&
+	    hero_dsim_write(dsim, open_fc, sizeof(open_fc)) &&
+	    hero_dsim_read(dsim, 0xb1, original + 1, sizeof(original) - 1) &&
+	    memcmp(test, original, sizeof(test) - 2) == 0) {
+		if (memcmp(test, original, sizeof(test)) == 0) {
+			printf("HEROLTE PANEL: AOR trial skipped, bootloader already set the trial value\n");
+		} else {
+			printf("HEROLTE PANEL: inherited AOR %02x%02x, trying stock index 128 for 2 s\n",
+			    original[9], original[10]);
+			const bool sent = hero_dsim_apply_aor(dsim, test);
+			if (sent) {
+				hg_msleep(2000);
+			}
+			/* An unsuccessful latch can still follow a submitted B1 write. Always restore. */
+			const bool restored = hero_dsim_apply_aor(dsim, original);
+			uint8_t readback[sizeof(original) - 1];
+			const bool verified = restored && hero_dsim_read(dsim, 0xb1, readback, sizeof(readback)) &&
+			    memcmp(original + 1, readback, sizeof(readback)) == 0;
+			printf("HEROLTE PANEL: AOR trial sent %u, original sent %u, restore verified %u\n",
+			    (unsigned)sent, (unsigned)restored, (unsigned)verified);
+		}
+	} else {
+		printf("HEROLTE PANEL: AOR trial skipped, inherited B1 could not be verified\n");
+	}
+	const bool closed_fc = hero_dsim_write(dsim, close_fc, sizeof(close_fc));
+	const bool closed_f0 = hero_dsim_write(dsim, close_f0, sizeof(close_f0));
+	if (!closed_fc || !closed_f0) {
+		printf("HEROLTE PANEL: failed to relock vendor command keys\n");
+	}
+}
+
+static void
+hero_dsim_panel_id(vm_offset_t dsim)
+{
+	uint8_t id[3];
+	if (!hero_dsim_read(dsim, 0x04, id, sizeof(id))) {
+		return;
+	}
+	printf("HEROLTE PANEL: DCS ID %02x%02x%02x\n", id[0], id[1], id[2]);
+	int dim = 0;
+	if (id[0] == 0 && id[1] == 0x40 && id[2] == 0x44 &&
+	    PE_parse_boot_argn("heropaneldim", &dim, sizeof(dim)) && dim == 1) {
+		hero_dsim_aor_trial(dsim);
 	}
 }
 
