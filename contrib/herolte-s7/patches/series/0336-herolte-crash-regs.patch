diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index f0b657f..a652279 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -702,6 +702,10 @@ IOSurfaceRootUserClient::returnSurface(SweetSurface *s, IOExternalMethodArgument
 	return ret;
 }
 
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+static int sweet_surface_planar_logged;
+#endif
+
 IOReturn
 IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
 {
@@ -838,6 +842,24 @@ IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
 		return ret;
 	}
 	ret = returnSurface(s, args);   /* takes the creator's user count */
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	/* (0336) where a planar surface landed in its creator, and its planes */
+	if (ret == kIOReturnSuccess && s->planeCount > 0 && sweet_surface_planar_logged < 24) {
+		sweet_surface_planar_logged++;
+		IOLockLock(fLock);
+		SweetSurfaceRef *ref = findRef(s->id, NULL);
+		unsigned long long at = ref != NULL && ref->data != NULL ? (unsigned long long)ref->data->getAddress() : 0ULL;
+		IOLockUnlock(fLock);
+		IOLog("SWEET SURF: id %u planar at 0x%llx alloc %u offset %u\n", s->id,
+		    at,
+		    s->allocSize, s->offset);
+		for (uint32_t i = 0; i < s->planeCount; i++) {
+			IOLog("SWEET SURF:   id %u plane %u %ux%u bpr %u offset %u size %u bpe %u\n", s->id, i,
+			    s->planes[i].width, s->planes[i].height, s->planes[i].bytesPerRow, s->planes[i].offset,
+			    s->planes[i].size, s->planes[i].bytesPerElement);
+		}
+	}
+#endif
 	s->release();
 	return ret;
 }
