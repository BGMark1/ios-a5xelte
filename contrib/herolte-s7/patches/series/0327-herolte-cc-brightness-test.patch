+/* Optional test input in physical panel coordinates. */
+static void
+hg_cc_drag(unsigned x, unsigned start, unsigned end)
+{
+	extern void sweet_hid_touch(int, int, int, int);
+	for (unsigned step = 0; step <= 15; step++) {
+		unsigned y = (start * (15 - step) + end * step) / 15;
+		sweet_hid_touch(9, 1, x, y);
+		hg_msleep(30);
+	}
+	sweet_hid_touch(9, 0, x, end);
+}
