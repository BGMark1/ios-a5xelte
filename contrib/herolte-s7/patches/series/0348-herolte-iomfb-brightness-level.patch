 OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
 
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+/*
+ * (0348) iOS 16's CoreBrightness sets the panel level with IORegistryEntrySetCFProperty(<IOMobileFramebuffer>,
+ * "IOMFBBrightnessLevel", CFNumber) (CoreBrightness 0x1af016810). Without setProperties here IOService answered
+ * kIOReturnUnsupported. The level is kept (readable as the same property, and herolte_bright_level for the panel code)
+ * and logged: the first 24 values, then every change of more than 1/16 of the last one.
+ */
+extern "C" volatile uint32_t herolte_bright_level;
+volatile uint32_t herolte_bright_level;
+
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (!d) {
+		return kIOReturnBadArgument;
+	}
+	OSNumber *level = OSDynamicCast(OSNumber, d->getObject("IOMFBBrightnessLevel"));
+	if (!level) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(d);
+		OSSymbol *key = it ? OSDynamicCast(OSSymbol, it->getNextObject()) : NULL;
+		if (fBrightLogged < 64) {
+			fBrightLogged++;
+			IOLog("SWEET FB: setProperties %s (%u keys) unsupported\n", key ? key->getCStringNoCopy() : "?", d->getCount());
+		}
+		OSSafeReleaseNULL(it);
+		return kIOReturnUnsupported;
+	}
+	uint32_t v = level->unsigned32BitValue(), last = herolte_bright_level;
+	uint32_t diff = v > last ? v - last : last - v;
+	if (fBrightLogged < 24 || diff > last / 16) {
+		fBrightLogged++;
+		IOLog("SWEET FB: IOMFBBrightnessLevel %u (%#x, %u bits)\n", v, v, level->numberOfBits());
+	}
+	herolte_bright_level = v;
+	setProperty("IOMFBBrightnessLevel", level);
+	return kIOReturnSuccess;
+}
+#endif
+
