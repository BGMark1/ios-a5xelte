diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index 9b9db12..992fcaf 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -2532,6 +2532,28 @@ hg_power_thread(__unused void *arg, __unused wait_result_t wr)
 			printf("HEROLTE POWER: SoC %d C (big %d, little %d, GPU %d, ISP %d; most %d), battery reg %d.%u C, Mongoose %s, screen %s\n",
 			    top, c[0], c[1], c[2], c[3], seen_max, b / 10, (unsigned)(b < 0 ? -b : b) % 10, hc.high ? "up" : "down", off ? "off" : "on");
 			seen_max = -1000;
+			/* (0346) per-CPU busy share since the last line, from the scheduler's own idle accounting */
+			extern struct processor *cpu_to_processor(int cpu);
+			extern void processor_cpu_load_info(struct processor *processor, natural_t ticks[4]);
+			static natural_t last[8][4];
+			char line[160];
+			int len = 0;
+			unsigned total_busy = 0, total_all = 0;
+			for (int cpu = 0; cpu < 8; cpu++) {
+				struct processor *pr = cpu_to_processor(cpu);
+				if (!pr) {
+					continue;
+				}
+				natural_t t[4] = { 0, 0, 0, 0 };
+				processor_cpu_load_info(pr, t);
+				unsigned busy = (t[0] - last[cpu][0]) + (t[1] - last[cpu][1]);
+				unsigned all = busy + (t[2] - last[cpu][2]);
+				memcpy(last[cpu], t, sizeof(t));
+				total_busy += busy;
+				total_all += all;
+				len += snprintf(line + len, sizeof(line) - (size_t)len, " %u", all ? busy * 100u / all : 0u);
+			}
+			printf("HEROLTE LOAD: busy %%:%s (all %u%%)\n", line, total_all ? total_busy * 100u / total_all : 0u);
 		}
 	}
 }
