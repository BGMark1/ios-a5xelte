+	if (logged++ % (unsigned)every == 0) {
 		IOLog("SWEET BATTERY: %u%% %umV %dmA rem=%umAh full=%umAh external=%d charging=%d done=%d\n",
 		    percent, mv, ma, rem, full, external, charging, isFull);
 	}
