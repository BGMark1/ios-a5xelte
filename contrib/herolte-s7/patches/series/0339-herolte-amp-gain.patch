diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index a5e46f4..08c8906 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -2957,6 +2957,21 @@ ha_tone(void)
 		ok = ha_amp_write(ha_amp_table[i][0], ha_amp_table[i][1]) && ok;
 	}
 	ok = ha_amp_write(0x3a, 0xf8) && ok;
+	/*
+	 * (0339) MAX98506 0x2D: DAC_IN_SEL [6:5] (3 = (L+R)/2, 2 = L+R), SPK_GAIN [4:0] (1 dB steps,
+	 * 0x14 as Samsung's driver). Boot-arg heroampgain=0..31 and heroampsum=1 (L+R, +6 dB).
+	 */
+	{
+		uint32_t gain = 0x14, sum = 0;
+		PE_parse_boot_argn("heroampgain", &gain, sizeof(gain));
+		PE_parse_boot_argn("heroampsum", &sum, sizeof(sum));
+		if (gain > 31) {
+			gain = 31;
+		}
+		uint8_t r2d = (uint8_t)(((sum ? 2u : 3u) << 5) | gain);
+		ok = ha_amp_write(0x2d, r2d) && ok;
+		printf("HEROLTE AUDIO: amplifier gain %u, %s, 0x2d=%#x\n", gain, sum ? "L+R" : "(L+R)/2", r2d);
+	}
 	printf("HEROLTE AUDIO: amplifier %s\n", ok ? "answered" : "DID NOT ANSWER");
 	ha_step("I2S");
 	hg_wr(i2s, 0x00, 1u << 31);             /* CON_RSTCLR: the block out of reset, Linux's QUIRK_NEED_RSTCLR. Until then a write stalls */
