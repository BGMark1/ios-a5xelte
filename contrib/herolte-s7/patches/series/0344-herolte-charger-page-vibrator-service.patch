 /* Boot-arg herovib=N: once the APM answers, three pulses of N ms, a second apart (a hardware check). */
diff --git a/iokit/Kernel/arm/SweetBattery.cpp b/iokit/Kernel/arm/SweetBattery.cpp
index d5e2997..76d7983 100644
--- a/iokit/Kernel/arm/SweetBattery.cpp
+++ b/iokit/Kernel/arm/SweetBattery.cpp
@@ -17,6 +17,57 @@
 extern "C" int herolte_fg_init(void);
 extern "C" int herolte_chg_state(bool *external, bool *charging, bool *full);
 extern "C" void herolte_vib_init(void);
+extern "C" void herolte_vib_pattern(uint32_t on_ms, uint32_t off_ms, bool repeat, uint32_t intensity_q16);
+
+/*
+ * (0344) iOS 16's MediaExperience (FigVibrator_IOKit.c, used when libVibeSynthEngine reports no haptic hardware):
+ * IOServiceGetMatchingService(IOServiceNameMatching("vibrator")), then IORegistryEntrySetCFProperties with
+ * { hertz_millisecs: [ { intensity: 16.16 fixed }, on ms, bool, off ms ], repeat: bool } to start, and another
+ * hertz_millisecs (repeat false) to stop. The same lookup answers "has a vibrator".
+ */
+class SweetVibrator : public IOService {
+	OSDeclareDefaultStructors(SweetVibrator);
+public:
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(SweetVibrator, IOService);
+
+IOReturn
+SweetVibrator::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (!d) {
+		return kIOReturnBadArgument;
+	}
+	static unsigned logged;
+	if (logged < 16) {
+		logged++;
+		OSSerialize *ser = OSSerialize::withCapacity(256);
+		if (ser && d->serialize(ser)) {
+			IOLog("SWEET VIBRATOR: %.400s\n", ser->text());
+		}
+		OSSafeReleaseNULL(ser);
+	}
+	OSArray *a = OSDynamicCast(OSArray, d->getObject("hertz_millisecs"));
+	OSBoolean *repeat = OSDynamicCast(OSBoolean, d->getObject("repeat"));
+	uint32_t ms[2] = { 0, 0 }, q16 = 0;
+	unsigned n = 0;
+	for (unsigned i = 0; a && i < a->getCount(); i++) {
+		OSObject *o = a->getObject(i);
+		OSNumber *num = OSDynamicCast(OSNumber, o);
+		OSDictionary *sub = OSDynamicCast(OSDictionary, o);
+		if (num && n < 2) {
+			ms[n++] = num->unsigned32BitValue();
+		} else if (sub) {
+			OSNumber *in = OSDynamicCast(OSNumber, sub->getObject("intensity"));
+			if (in) {
+				q16 = in->unsigned32BitValue();
+			}
+		}
+	}
+	herolte_vib_pattern(ms[0], ms[1], repeat && repeat->isTrue(), q16);
+	return kIOReturnSuccess;
+}
 extern "C" int herolte_fg_read(unsigned *percent, unsigned *mv, int *ma,
     unsigned *rem_mah, unsigned *full_mah);
 #define BATTERY_DESIGN_MAH 3000u        /* SM-G930F EB-BG930ABE */
@@ -316,6 +367,19 @@ SweetBattery::start(IOService *provider)
 	/* Default on; herofg=0 keeps the static fallback. */
 	fReal = herolte_fg_init() == 0;
 	herolte_vib_init();
+	SweetVibrator *vib = OSTypeAlloc(SweetVibrator);
+	if (vib && vib->init()) {
+		vib->setName("vibrator");
+		if (vib->attach(this)) {
+			if (vib->start(this)) {
+				vib->registerService();
+				IOLog("SWEET VIBRATOR: registered\n");
+			} else {
+				vib->detach(this);
+			}
+		}
+	}
+	OSSafeReleaseNULL(vib);
 #else
 	int real = 0;
 	(void)PE_parse_boot_argn("sweetbattery", &real, sizeof(real));
