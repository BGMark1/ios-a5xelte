+static void
+hv_motor_locked(bool on)
+{
+	uint32_t tcon = fg_rd(hv_pwm, 0x08) & ~(0xbu << 8);
+	if (on) {
+		hv_pwm_set(hv_duty);
+		fg_wr(hv_pwm, 0x08, tcon | (1u << 9) | (1u << 11));
+		fg_wr(hv_pwm, 0x08, tcon | (1u << 8) | (1u << 11));
+		herolte_pmic66_write(0x10, 0x82u | 0x40u);
+	} else {
+		herolte_pmic66_write(0x10, 0x82u);
+		hv_pwm_set(HV_PERIOD_NS / 2);
+		fg_wr(hv_pwm, 0x08, tcon);
