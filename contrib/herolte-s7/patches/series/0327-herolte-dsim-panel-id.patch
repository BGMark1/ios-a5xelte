+/* Exynos8890 DSIM0 offsets checked against the stock SM-G930F kernel. */
+#define HERO_DSIM_STATUS 0x08
+#define HERO_DSIM_INTSRC 0x34
+#define HERO_DSIM_PKTHDR 0x3c
+#define HERO_DSIM_RXFIFO 0x44
+#define HERO_DSIM_FIFOCTRL 0x4c
+#define HERO_DSIM_CMD_CONFIG 0x78
+#define HERO_DSIM_HS_READY (1u << 10)
+#define HERO_DSIM_PH_EMPTY (1u << 10)
+#define HERO_DSIM_RX_EMPTY (1u << 12)
+#define HERO_DSIM_RX_DONE (1u << 18)
+#define HERO_DSIM_PACKETGO (1u << 21)
+
+/* Wait at most 100 ms without changing the inherited host configuration. */
+static bool
+hero_dsim_wait(vm_offset_t dsim, uint32_t reg, uint32_t bits)
+{
+	uint64_t start = mach_absolute_time(), timeout;
+	nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &timeout);
+	while ((hg_rd(dsim, reg) & bits) != bits) {
+		if (mach_absolute_time() - start >= timeout) {
+			return false;
+		}
+		delay(10);
+	}
+	return true;
+}
+
+/* DCS Get Display ID (0x04). This issues a read only; no vendor keys or dimming commands. */
+static void
+hero_dsim_panel_id(vm_offset_t dsim)
+{
+	const uint32_t fifo = hg_rd(dsim, HERO_DSIM_FIFOCTRL);
+	const uint32_t status = hg_rd(dsim, HERO_DSIM_STATUS);
+	const uint32_t config = hg_rd(dsim, HERO_DSIM_CMD_CONFIG);
+	if (!(status & HERO_DSIM_HS_READY) || (config & HERO_DSIM_PACKETGO) ||
+	    (fifo & (HERO_DSIM_PH_EMPTY | HERO_DSIM_RX_EMPTY)) != (HERO_DSIM_PH_EMPTY | HERO_DSIM_RX_EMPTY)) {
+		printf("HEROLTE PANEL: ID skipped, DSIM status %#x fifo %#x cmd config %#x\n", status, fifo, config);
+		return;
+	}
+
+	hg_wr(dsim, HERO_DSIM_INTSRC, HERO_DSIM_RX_DONE);
+	hg_wr(dsim, HERO_DSIM_PKTHDR, 0x37u | (3u << 8)); /* Maximum return packet size, 3 bytes */
+	if (!hero_dsim_wait(dsim, HERO_DSIM_FIFOCTRL, HERO_DSIM_PH_EMPTY)) {
+		printf("HEROLTE PANEL: DSIM did not send maximum return packet size\n");
+		return;
+	}
+	hg_wr(dsim, HERO_DSIM_PKTHDR, 0x06u | (0x04u << 8)); /* DCS read, bus turnaround by packet type */
+	const bool done = hero_dsim_wait(dsim, HERO_DSIM_INTSRC, HERO_DSIM_RX_DONE);
+	uint32_t id = 0, first = 0;
+	bool found = false, bad = false;
+	for (unsigned i = 0; i < 64 && !(hg_rd(dsim, HERO_DSIM_FIFOCTRL) & HERO_DSIM_RX_EMPTY); i++) {
+		const uint32_t hdr = hg_rd(dsim, HERO_DSIM_RXFIFO);
+		if (i == 0) {
+			first = hdr;
+		}
+		if ((hdr & 0x3f) == 0x1c || (hdr & 0x3f) == 0x1a) { /* DCS or generic long response */
+			const uint32_t size = (hdr >> 8) & 0xffff;
+			if (size != 3 || found || (hg_rd(dsim, HERO_DSIM_FIFOCTRL) & HERO_DSIM_RX_EMPTY)) {
+				bad = true;
+				break;
+			}
+			id = hg_rd(dsim, HERO_DSIM_RXFIFO);
+			i++;
+			found = true;
+		} else if ((hdr & 0x3f) != 0x08 && ((hdr & 0x3f) != 0x02 || ((hdr >> 8) & 0xffff) != 0)) {
+			bad = true;
+			break;
+		}
+	}
+	const uint32_t after = hg_rd(dsim, HERO_DSIM_FIFOCTRL);
+	hg_wr(dsim, HERO_DSIM_INTSRC, HERO_DSIM_RX_DONE);
+	if (found && !bad && (after & HERO_DSIM_RX_EMPTY)) {
+		printf("HEROLTE PANEL: DCS ID %02x%02x%02x\n", id & 0xff, (id >> 8) & 0xff, (id >> 16) & 0xff);
+	} else {
+		printf("HEROLTE PANEL: no valid DCS ID (done %u first %#x fifo %#x)\n", (unsigned)done, first, after);
+	}
+}
