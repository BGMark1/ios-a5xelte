diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index 7620c41..280ded9 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -98,6 +98,7 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 #define SWEET_TOP_PROCS 512
 static struct { int pid; uint64_t abs; char name[20]; uint64_t delta; } sweet_top[SWEET_TOP_PROCS];
 static unsigned sweet_top_n;
+static int sweet_top_print;
 static uint64_t sweet_top_gen;
 
 #if defined(ARM64_BOARD_CONFIG_HEROLTE)
@@ -122,16 +123,27 @@ sweet_top_cap(task_t task, const char *name)
 		percent = 30;
 		PE_parse_boot_argn("herowidgetcap", &percent, sizeof(percent));
 	}
+	/*
+	 * (0347) com.apple.voicemail.vmd, with no telephony here, spins two cores for the whole session (sweettop, pwr13b:
+	 * "vmd 193%" in every 5 s sample, little cores ~50% busy on an idle home screen). Boot-arg herovmdcap=N percent of
+	 * a core, default 5, 0 off.
+	 */
+	static int vmd_percent = -1;
+	if (vmd_percent < 0) {
+		vmd_percent = 5;
+		PE_parse_boot_argn("herovmdcap", &vmd_percent, sizeof(vmd_percent));
+	}
 	bool widget = false;
 	for (const char *c = name; *c != '\0' && !widget; c++) {
 		widget = strncmp(c, "Widge", 5) == 0;
 	}
-	if (percent <= 0 || percent > 100 || !widget) {
+	int limit = widget ? percent : strcmp(name, "vmd") == 0 ? vmd_percent : 0;
+	if (limit <= 0 || limit > 100) {
 		return;
 	}
-	int err = proc_set_task_ruse_cpu(task, HERO_RUSE_THROTTLE, (uint8_t)percent, 0, 0, 1);
+	int err = proc_set_task_ruse_cpu(task, HERO_RUSE_THROTTLE, (uint8_t)limit, 0, 0, 1);
 	if (told++ < 24) {
-		printf("HEROLTE CAP: %s limited to %d%% of a core: %d\n", name, percent, err);
+		printf("HEROLTE CAP: %s limited to %d%% of a core: %d\n", name, limit, err);
 	}
 }
 #endif
@@ -181,7 +193,7 @@ sweet_top_thread(__unused void *arg, __unused wait_result_t wr)
 			sweet_top[i].delta = 0;
 		}
 		proc_iterate(PROC_ALLPROCLIST, sweet_top_proc, NULL, NULL, NULL);
-		if (sweet_top_gen++ == 0) {
+		if (sweet_top_gen++ == 0 || !sweet_top_print) {
 			continue;               /* the first pass only takes the baseline */
 		}
 		char line[400];
@@ -219,8 +231,14 @@ sweet_sample_start(void)
 		thread_deallocate(thread);
 	}
 	int top = 0;
-	if (PE_parse_boot_argn("sweettop", &top, sizeof(top)) && top &&
-	    kernel_thread_start(sweet_top_thread, NULL, &thread) == KERN_SUCCESS) {
+	sweet_top_print = PE_parse_boot_argn("sweettop", &top, sizeof(top)) && top;
+#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+	/* (0347) the CPU caps live in this sampler: run it in every boot, quietly without sweettop */
+	top = 1;
+#else
+	top = sweet_top_print;
+#endif
+	if (top && kernel_thread_start(sweet_top_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
 }
