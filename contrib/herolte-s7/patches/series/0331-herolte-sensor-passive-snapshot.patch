diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index fdfe4f2..d1c2a01 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -3267,6 +3267,30 @@ hg_wifi_thread(__unused void *arg, __unused wait_result_t wr)
 	herolte_wifi_firmware(cfg);
 }
 
+/* Passive snapshot of the Galaxy S7's Broadcom hub wiring. Do not read the
+ * SPI controller yet: its clocks may be gated and the read can stall the bus.
+ * The GPIO and PERIC1 CMU blocks are already used by keys, fuel gauge and audio.
+ */
+static void
+hg_sensor_snapshot(void)
+{
+	vm_offset_t alive = ml_io_map(0x10580000u, 0x1000);
+	vm_offset_t peric0 = ml_io_map(0x136d0000u, 0x1000);
+	vm_offset_t peric1 = ml_io_map(HA_PINS_PA, 0x1000);
+	vm_offset_t cmu = ml_io_map(HA_CMU_PA, 0x1000);
+	if (!alive || !peric0 || !peric1 || !cmu) {
+		printf("HEROLTE SSP: snapshot mapping failed\n");
+		return;
+	}
+	printf("HEROLTE SSP: GPB1 con=%#x dat=%#x GPA3 con=%#x dat=%#x\n",
+	    hg_rd(peric0, 0xa0), hg_rd(peric0, 0xa4), hg_rd(alive, 0x60), hg_rd(alive, 0x64));
+	printf("HEROLTE SSP: GPE2 con=%#x dat=%#x GPE6 con=%#x dat=%#x GPG0 con=%#x dat=%#x\n",
+	    hg_rd(peric1, HA_GPE2), hg_rd(peric1, HA_GPE2 + 4), hg_rd(peric1, HA_GPE6),
+	    hg_rd(peric1, HA_GPE6 + 4), hg_rd(peric1, 0x140), hg_rd(peric1, 0x144));
+	printf("HEROLTE SSP: SPI1 clock mux=%#x stat=%#x gate=%#x\n",
+	    hg_rd(cmu, 0x208), hg_rd(cmu, 0x608), hg_rd(cmu, 0x844));
+}
+
 void
 herolte_gpu_probe(void)
 {
@@ -3274,6 +3298,11 @@ herolte_gpu_probe(void)
 	thread_t thread;
 	uint32_t twrp = 0;
 
+	uint32_t sensors = 0;
+	if (PE_parse_boot_argn("herossp", &sensors, sizeof(sensors)) && sensors == 1) {
+		hg_sensor_snapshot();
+	}
+
 	PE_parse_boot_argn("herogpu_flush", &hg_flush_mode, sizeof(hg_flush_mode));
 	int wifi = 1;                                           /* herowifi=0: no Wi-Fi */
 	PE_parse_boot_argn("herowifi", &wifi, sizeof(wifi));
